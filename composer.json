{
    "name": "rostamlabs/rostam-cache-laravel",
    "description": "A Laravel cache driver for Rostam - speaks the native binary TCP protocol of the Rostam key-value engine, with pipelining, atomic locks and tag support.",
    "keywords": [
        "laravel",
        "cache",
        "rostam",
        "key-value",
        "driver"
    ],
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Keivan Sohrabloo",
            "email": "K.sohrabloo.k@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "rostamlabs/rostam-client-php": "^0.1",
        "illuminate/cache": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Rostam\\Cache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rostam\\Cache\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rostam\\Cache\\RostamCacheServiceProvider"
            ],
            "aliases": {
                "Rostam": "Rostam\\Cache\\Facades\\Rostam"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "fix": "pint"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
